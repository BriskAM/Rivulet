{
  "manifest_version": 3,
  "name": "Rivulet",
  "version": "0.1.0",
  "description": "Send browser downloads to your aria2 daemon and monitor them from the toolbar. Companion to the Rivulet macOS app.",
  "browser_specific_settings": {
    "gecko": {
      "id": "rivulet@local",
      "strict_min_version": "128.0"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Rivulet",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "permissions": [
    "downloads",
    "cookies",
    "storage",
    "contextMenus",
    "notifications",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
